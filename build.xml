<project name="LibraryManagement" default="war" basedir=".">

    <!-- Project directories -->
    <property name="src.dir" value="src/main/java"/>
    <property name="resources.dir" value="src/main/resources"/>
    <property name="web.dir" value="src/main/webapp"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>

    <!-- Clean previous builds -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- Compile Java -->
    <target name="compile">

        <mkdir dir="${classes.dir}"/>

        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               includeantruntime="false">

            <classpath>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>

        </javac>

        <!-- Copy resources (persistence.xml, struts.xml etc.) -->
        <copy todir="${classes.dir}">
            <fileset dir="${resources.dir}" erroronmissingdir="false"/>
        </copy>

        <!-- Copy validation XML files (IMPORTANT) -->
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}">
                <include name="**/*-validation.xml"/>
            </fileset>
        </copy>

    </target>

    <!-- Create WAR -->
    <target name="war" depends="compile">

        <mkdir dir="${dist.dir}"/>

        <war destfile="${dist.dir}/library-management.war"
             webxml="${web.dir}/WEB-INF/web.xml">

            <!-- JSP / HTML / CSS -->
            <fileset dir="${web.dir}">
                <exclude name="WEB-INF/web.xml"/>
            </fileset>

            <!-- compiled classes -->
            <classes dir="${classes.dir}"/>

            <!-- dependency jars -->
            <lib dir="${lib.dir}"/>

        </war>

    </target>

</project>